{
  "name": "@fiefs/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "reset": "tsx --env-file-if-exists=../.env src/migrate.ts --reset",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/websocket": "^11.0.0",
    "@fiefs/shared": "*",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "vitest": "^5.0.0"
  }
}
