# Connexion PostgreSQL (docker compose up -d la fournit)
DATABASE_URL=postgres://fiefs:fiefs@localhost:5432/fiefs
# Port de l'API
PORT=3001
# Vitesse du monde : 1 = vitesse normale, 10 = tout va 10 fois plus vite (pratique en local)
WORLD_SPEED=10
# Taille de la carte (carré de MAP_SIZE x MAP_SIZE cases)
MAP_SIZE=100
# Nombre de villages barbares créés au démarrage d'un monde
BARBARIAN_VILLAGES=250
